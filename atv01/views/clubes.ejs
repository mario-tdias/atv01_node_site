<%- include('partials/header') %>
<%- include('partials/navbar') %>

<div class="container mt-5">

  <h1 class="text-center mb-4">Clubes</h1>

  <div class="row">
    
    <% clubes.forEach(clube => { %>
      
      <div class="col-md-4">
        <div class="card shadow mb-4">
          
          <img src="<%= clube.imagem %>" alt="<%= clube.nome %>">

          <div class="card-body">
            <h5 class="card-title"><%= clube.nome %></h5>
            <p class="card-text">
              País: <%= clube.pais %><br>
              Estádio: <%= clube.estadio %>
            </p>
          </div>

        </div>
      </div>

    <% }) %>

  </div>
</div>


<%- include('partials/footer') %>